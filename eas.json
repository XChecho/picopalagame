{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_REACT_API": "https://picopalaapi.xchecho.com/api/v1"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_REACT_API": "https://picopalaapi.xchecho.com/api/v1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
